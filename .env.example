# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so it must
# never contain a real value.
#
#   cp .env.example .env.local && chmod 600 .env.local
#
# Then run Cloudflare commands through the wrapper, which reads the file without printing it:
#
#   bash scripts/with-cf.sh npx wrangler d1 list

# Account-scoped API token. Permissions needed, and nothing else:
#   D1                 Edit     create the database, run the schema, query it
#   Workers Scripts    Edit     deploy the Worker, set the PEPPER secret
#   Cloudflare Pages   Edit     deploy the site
#   Account Analytics  Read     read download counts without opening the dashboard
# When a domain exists, add these two scoped to that zone only:
#   Zone > DNS         Edit
#   Zone > Zone        Read
CLOUDFLARE_API_TOKEN=

# Safe to share. Dashboard URL, or `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# Only once the counter is deployed. Empty means Yellide sends nothing, which is the default.
YELLIDE_COUNTER=
